{
  "name": "serenojs-workspace",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.15",
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "pnpm build:package && pnpm build:admin && pnpm --filter serenojs-starter dev",
    "build": "pnpm build:package && pnpm build:admin && pnpm --filter serenojs-starter build",
    "start": "pnpm --filter serenojs-starter start",
    "typegen": "pnpm --filter serenojs-starter typegen",
    "build:admin": "vite build --config packages/serenojs/vite.admin.config.ts",
    "build:package": "pnpm --filter @eutobias/serenojs build",
    "build:create": "pnpm --filter create-start-serenojs build",
    "test": "pnpm build:admin && pnpm --filter @eutobias/serenojs test",
    "test:coverage": "pnpm build:admin && pnpm --filter @eutobias/serenojs test:coverage",
    "pack:package": "pnpm build:package && pnpm build:admin && pnpm --filter @eutobias/serenojs pack",
    "publish:package": "pnpm build:package && pnpm build:admin && pnpm --filter @eutobias/serenojs publish"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.0"
  }
}
